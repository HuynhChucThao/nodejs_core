# Database connection string (MySQL on Aiven / PlanetScale / Supabase / etc.)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?ssl-mode=REQUIRED
DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED"

# JWT secret key used for signing authentication tokens
JWT_SECRET="your-super-secret-jwt-key"

# Gemini API Key for AI Career Consultant
GEMINI_API_KEY="your-gemini-api-key"

# Port (configured automatically by cloud providers like Render/Railway/Fly)
PORT=3000

# Frontend URL for CORS (comma-separated if multiple, or * for all)
# Example: https://your-riasec-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=
